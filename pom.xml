<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.sparklearn</groupId>
  <artifactId>spark-learn</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>spark-learn</name>
  <description>Scala Spark learning project (Spark 4.2.1)</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <scala.version>2.13.18</scala.version>
    <scala.binary.version>2.13</scala.binary.version>
    <!-- Latest 4.2.x. Matches ClickHouse connector spark-4.2 profile (built vs 4.2.1). -->
    <spark.version>4.2.1</spark.version>
    <!-- 0.11.0: first release with clickhouse-spark-runtime-4.2 (no more 4.0-on-4.x mismatch). -->
    <clickhouse.spark.binary.version>4.2</clickhouse.spark.binary.version>
    <clickhouse.spark.connector.version>0.11.0</clickhouse.spark.connector.version>
    <!-- Align with connector 0.11.0 (bundles client/JDBC 0.11.1). -->
    <clickhouse.jdbc.version>0.11.1</clickhouse.jdbc.version>
    <!-- 0.12.3: Spark 4.2 temp-function identifier fixes. -->
    <graphframes.version>0.12.3</graphframes.version>
    <!-- provided by default (cluster / spark-submit). Override with -Plocal for IDE runs. -->
    <spark.scope>provided</spark.scope>
  </properties>

  <dependencies>
    <!--
      Needed to compile Scala sources. Cluster / spark-submit already has a matching
      Scala runtime, so the default scope is provided. -Plocal switches it to compile.
    -->
    <dependency>
      <groupId>org.scala-lang</groupId>
      <artifactId>scala-library</artifactId>
      <version>${scala.version}</version>
      <scope>${spark.scope}</scope>
    </dependency>

    <!--
      provided: Spark jars live on the cluster / spark-submit classpath.
      They must NOT be packed into the uber-jar (avoids huge jar and classpath conflicts).
    -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-core_${scala.binary.version}</artifactId>
      <version>${spark.version}</version>
      <scope>${spark.scope}</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_${scala.binary.version}</artifactId>
      <version>${spark.version}</version>
      <scope>${spark.scope}</scope>
    </dependency>
    <!--
      GraphFrames PageRank calls Breeze, which ships in spark-mllib.
      The Spark distribution already has this jar in $SPARK_HOME/jars.
      -Plocal puts it on the IDE / scala:run classpath.
    -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-mllib_${scala.binary.version}</artifactId>
      <version>${spark.version}</version>
      <scope>${spark.scope}</scope>
    </dependency>
    <!--
      S3/GCS/Azure connectors (hadoop-aws, AWS SDK, …).
      provided: not packed into the uber-jar; put jars on the cluster
      (-packages or $SPARK_HOME/jars). -Plocal includes them for IDE runs.
      See installation/S3.md.
    -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-hadoop-cloud_${scala.binary.version}</artifactId>
      <version>${spark.version}</version>
      <scope>${spark.scope}</scope>
    </dependency>
    <!--
      ClickHouse Spark connector (DataSource V2 + catalog).
      Runtime artifact matches Spark major.minor (4.2) — no cross-version mismatch.
      provided: not packed into the uber-jar; copy jars from
      installation/spark-clickhouse-jars into $SPARK_HOME/jars.
      -Plocal includes them for IDE runs.
    -->
    <dependency>
      <groupId>com.clickhouse.spark</groupId>
      <artifactId>clickhouse-spark-runtime-${clickhouse.spark.binary.version}_${scala.binary.version}</artifactId>
      <version>${clickhouse.spark.connector.version}</version>
      <scope>${spark.scope}</scope>
    </dependency>
    <dependency>
      <groupId>com.clickhouse</groupId>
      <artifactId>clickhouse-jdbc</artifactId>
      <version>${clickhouse.jdbc.version}</version>
      <classifier>all</classifier>
      <scope>${spark.scope}</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!--
      GraphFrames for Spark 4 / Scala 2.13. Runtime also needs
      graphframes-graphx-spark4 (internal GraphX fork) + DataSketches;
      copy those from installation/spark-graphframes-jars into $SPARK_HOME/jars.
    -->
    <dependency>
      <groupId>io.graphframes</groupId>
      <artifactId>graphframes-spark4_${scala.binary.version}</artifactId>
      <version>${graphframes.version}</version>
      <scope>${spark.scope}</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/scala</sourceDirectory>
    <testSourceDirectory>src/test/scala</testSourceDirectory>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
        <version>4.9.5</version>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>testCompile</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <scalaVersion>${scala.version}</scalaVersion>
          <args>
            <arg>-deprecation</arg>
            <arg>-feature</arg>
          </args>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.sparklearn.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!--
        Uber-jar: application classes + compile-scoped deps (Spark stays provided).
        Submit: spark-submit -class com.sparklearn.Main -master spark://HOST:7077 target/spark-learn-1.0.0-uber.jar
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>uber</shadedClassifierName>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/LICENSE.txt</exclude>
                    <exclude>META-INF/NOTICE.txt</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sparklearn.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    Local/IDE without spark-submit: mvn -Plocal ...
    Or in IntelliJ: include dependencies with Provided scope in the run config.
    Do not use -Plocal when building the cluster uber-jar.
  -->
  <profiles>
    <profile>
      <id>local</id>
      <properties>
        <spark.scope>compile</spark.scope>
      </properties>
    </profile>
  </profiles>
</project>
